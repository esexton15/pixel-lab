---
import '../style.css'
import Button from '../components/Button.astro'
import { customChannelRules, filters, kioskFilters } from '../filters.js'

const exhibitTitle = 'The Code Behind Image Filters'
const sampleBase = import.meta.env.BASE_URL.replace(/\/$/, '')
const samples = [
  { id: 'astronaut', label: 'Astronaut' },
  { id: 'mountains', label: 'Mountains' },
  { id: 'cat', label: 'Cat' },
  { id: 'coffee', label: 'Coffee' },
]

const frameClass = 'relative grid aspect-square place-items-center overflow-hidden rounded-md border bg-muted'
const canvasClass = 'absolute h-auto max-h-full w-auto max-w-full cursor-crosshair touch-manipulation focus-visible:outline-2 focus-visible:-outline-offset-2'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{exhibitTitle}</title>
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href={`${sampleBase}/favicon.ico`} />
    <link rel="manifest" href={`${sampleBase}/manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${sampleBase}/icons/pixel-192.png`} />
  </head>
  <body>
    <main id="exhibit" data-mode="kiosk" class="space-y-4 p-4 sm:p-6">
      <header id="kiosk-header" class="text-center">
        <p class="text-sm font-medium text-muted-foreground">Ivy Tech</p>
        <h1 class="text-3xl font-semibold sm:text-5xl">{exhibitTitle}</h1>
      </header>

      <header id="explore-header" class="grid items-start gap-4 md:grid-cols-2 md:gap-6" hidden>
        <div class="space-y-1">
          <p class="flex items-center gap-2 text-sm text-muted-foreground">
            <img src={`${sampleBase}/favicon.ico`} width="16" height="16" alt="" class="shrink-0" />
            Ivy Tech - School of Information Technology
          </p>
          <h1 class="text-3xl font-semibold">{exhibitTitle}</h1>
          <p class="max-w-2xl text-sm text-muted-foreground">
            A photo is a grid of pixels. Each RGB pixel has three numbers that tell
            the screen how much red, green, and blue to show. Pick a rule to change
            those numbers.
          </p>
        </div>
        <div class="space-y-2 md:justify-self-end">
          <h2 class="text-sm font-medium">Choose an image</h2>
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Input source">
            {samples.map(({ id, label }, index) => (
              <Button
                id={id}
                data-sample={`${sampleBase}/samples/${id}.jpg`}
                aria-pressed={index === 0 ? 'true' : 'false'}
                class="h-auto! flex-col gap-1 p-1!"
              >
                <img src={`${sampleBase}/samples/${id}.jpg`} alt="" width="48" height="48" class="size-12 rounded-sm object-cover" />
                <span class="text-xs">{label}</span>
              </Button>
            ))}
            <Button id="camera" aria-pressed="false">Live camera</Button>
            <Button id="freeze" hidden>Freeze</Button>
          </div>
          <p id="status" class="text-sm" role="status" hidden></p>
        </div>
      </header>

      <section id="explore-controls" class="space-y-3" aria-label="Exhibit controls" hidden>
        <div class="space-y-2">
          <h2 id="filter-heading" class="text-base font-semibold">Choose a filter</h2>
          <div id="filters" class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-5" role="group" aria-labelledby="filter-heading">
            {filters.map((filter, index) => (
              <Button class="h-12! px-2! text-base!" aria-pressed={index === 0 ? 'true' : 'false'}>
                {filter.label}
              </Button>
            ))}
            <Button id="custom-filter" class="h-12! px-2! text-base! aria-[pressed=false]:border-dashed" aria-pressed="false">
              Custom
            </Button>
          </div>
        </div>
      </section>

      <section id="image-pipeline" class="grid grid-cols-2 gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(17rem,.85fr)_minmax(0,1fr)]" aria-label="Image processing pipeline">
        <article class="min-w-0 space-y-2">
          <h2 class="text-sm font-medium text-muted-foreground">Input <span class="ml-1">· Original</span></h2>
          <div class={frameClass}>
            <canvas id="before" class={canvasClass} tabindex="-1" aria-label="Original image. Use arrow keys to move the pixel selector."></canvas>
          </div>
        </article>
        <section id="processing-panel" class="col-span-2 row-start-1 grid min-w-0 gap-2 self-center border-t py-3 sm:grid-cols-2 sm:gap-4 lg:col-span-1 lg:row-start-auto lg:grid-cols-1" aria-labelledby="processing">
          <div class="min-w-0">
            <h2 id="processing" class="font-semibold">
              <span id="processing-label" class="block text-xs text-muted-foreground" hidden>Processing</span>
              <span id="preview-filter" class="block text-xl sm:text-2xl"></span>
            </h2>
            <p id="description" class="mt-1 h-10 overflow-y-auto text-sm text-muted-foreground"></p>
            <ol id="preview-filters" class="mt-2 grid grid-cols-2 gap-1" aria-label="Filter rotation">
              {kioskFilters.map((filter, index) => (
                <li
                  aria-current={index === 0 ? 'step' : undefined}
                  class="rounded border border-transparent px-2 py-1 text-xs text-muted-foreground transition-colors duration-300 motion-reduce:transition-none aria-[current=step]:border-primary aria-[current=step]:bg-primary aria-[current=step]:text-primary-foreground"
                >
                  {filter.label}
                </li>
              ))}
            </ol>
          </div>
          <div class="flex h-32 min-w-0 flex-col overflow-hidden rounded-md border bg-muted/40">
            <div class="shrink-0 border-b px-3 py-1 text-xs text-muted-foreground">JavaScript</div>
            <div id="custom-controls" class="grid shrink-0 grid-cols-3 gap-2 border-b p-2" hidden>
              {['Red', 'Green', 'Blue'].map((channel, index) => (
                <label class="min-w-0 text-xs font-medium">
                  {channel} output
                  <select class="mt-1 block w-full rounded border bg-background px-1 py-1">
                    {customChannelRules.map((rule, ruleIndex) => (
                      <option value={ruleIndex} selected={index === ruleIndex}>{rule.label}</option>
                    ))}
                  </select>
                </label>
              ))}
            </div>
            <pre tabindex="0" aria-label="Filter code" class="min-h-0 flex-1 overflow-auto px-3 py-2 font-mono text-sm leading-4 tab-size-2"><code id="code"></code></pre>
          </div>
          <hr id="processing-divider" class="col-span-full border-border" />
          <section id="pixel-comparison" class="col-span-full space-y-2" aria-labelledby="compare-heading">
            <h2 id="compare-heading" class="text-xs font-semibold text-muted-foreground">Compare</h2>
            <div id="pixel-comparison-readouts" class="grid grid-cols-2 gap-2 opacity-60"></div>
            <hr id="compare-divider" class="border-border" />
          </section>
        </section>
        <article class="min-w-0 space-y-2">
          <h2 class="text-sm font-semibold">Output <span class="ml-1 font-normal text-muted-foreground">· Filtered</span></h2>
          <div class={frameClass}>
            <canvas id="after" class={canvasClass} tabindex="-1" aria-label="Filtered image. Use arrow keys to move the pixel selector."></canvas>
          </div>
        </article>
      </section>

      <p id="inspect-hint" class="text-sm text-muted-foreground" hidden>Tap or point at either image to inspect a pixel.</p>

      <footer id="attract" class="text-center">
        <Button id="explore" class="h-16! w-full max-w-sm bg-primary! text-xl! text-primary-foreground! hover:bg-primary/90!">Tap to explore</Button>
        <p id="offline-status" class="mt-2 text-xs text-muted-foreground" role="status" hidden></p>
      </footer>
    </main>
    <script src="../app.js"></script>
    <script src="../offline.js"></script>
  </body>
</html>
